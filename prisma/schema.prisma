// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String?
  imageUrl         String?
  currency         String            @default("INR")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  Records          Record[]
  Budgets          Budget[]
  Sessions         Session[]
  PasswordResetTokens PasswordResetToken[]
  AiInsightCache   AiInsightCache[]
  Goals            Goal[]
  recurringRecords RecurringRecord[]
  categories       UserCategory[]
}

model UserCategory {
  id         String    @id @default(uuid())
  userId     String
  categoryId String
  label      String
  iconName   String
  color      String
  isCustom   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
}

model Goal {
  id                  String    @id @default(uuid())
  userId              String
  name                String
  targetAmount        Float
  currentAmount       Float     @default(0)
  monthlyContribution Float     @default(0)
  category            String    @default("other")
  deadline            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Budget {
  id            String   @id @default(uuid())
  userId        String
  amount        Float
  cadence       String   @default("monthly")
  effectiveFrom DateTime
  currency      String   @default("INR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cadence, effectiveFrom])
  @@index([userId, effectiveFrom])
}

model Record {
  id          String           @id @default(uuid())
  text        String
  amount      Float
  type        String           @default("expense")
  category    String           @default("other")
  date        DateTime         @default(now())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringId String?
  recurring   RecurringRecord? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([userId, type, date])
}

model RecurringRecord {
  id            String    @id @default(uuid())
  userId        String
  text          String
  amount        Float
  type          String    @default("expense")
  category      String    @default("other")
  frequency     String    @default("monthly")
  interval      Int       @default(1)
  startDate     DateTime
  endDate       DateTime?
  lastProcessed DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  records       Record[]

  @@index([userId])
  @@index([userId, active])
}

// Stores completed mutation tokens so a retry can return the original result
// instead of creating or deleting another user-owned record.
model MutationRequest {
  id        String   @id @default(uuid())
  userId    String
  requestId String
  operation String
  recordId  String?
  createdAt DateTime @default(now())

  @@unique([userId, requestId, operation])
  @@index([userId])
}

model AiInsightCache {
  id          String   @id @default(uuid())
  userId      String
  periodStart String
  periodEnd   String
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart, periodEnd])
  @@index([userId])
}
