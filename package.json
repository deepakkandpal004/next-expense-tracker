{
  "name": "next-expense-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:test": "prisma generate && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://test:test@127.0.0.1:5432/expense_ai_test?schema=public} NEXT_TELEMETRY_DISABLED=1 OPENROUTER_API_KEY=test-disabled-key next build",
    "start": "next start",
    "start:test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://test:test@127.0.0.1:5432/expense_ai_test?schema=public} NEXT_TELEMETRY_DISABLED=1 OPENROUTER_API_KEY=test-disabled-key NODE_OPTIONS=--require=./tests/setup/block-external-network.cjs next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:ci": "CI=true vitest run",
    "test:ai-provider:live": "RUN_LIVE_AI_PROVIDER_CONTRACT=true vitest run lib/ai.live.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:prod": "npm run build:test && npm run test:e2e",
    "test:e2e:prod:smoke": "npm run build:test && npm run test:e2e:smoke",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "validate:tooling": "npm run test:e2e:prod:smoke && npm run check"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-alert-dialog": "1.1.19",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "1.24.0",
    "next": "^15.5.9",
    "next-themes": "0.4.6",
    "openai": "^5.23.2",
    "perfect-debounce": "^2.0.0",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "postcss": "^8.5.6",
    "prisma": "^6.11.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
